# PostgreSQL async DSN (for asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/reviewsense

# Runtime environment: development, testing, production
ENVIRONMENT=development

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Optional: override model paths
# AUTHENTICITY_MODEL_PATH=models/authenticity_model.txt